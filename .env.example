# ==============================================================================
# BE11 — Premium Cricket Ground Booking Platform
# Environment Variables Specification (.env.example)
# ==============================================================================

# ==============================================================================
# 1. VERCEL PRODUCTION ENVIRONMENT VARIABLES (Required in Vercel Project Settings)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Production PostgreSQL Database Connection String (Supabase, Neon, Railway, RDS, etc.)
# Note: Prisma schema uses provider = "postgresql". Requires connection pooling or direct SSL connection.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/be11?sslmode=require&pgbouncer=true"

# Secret Key for Signing JSON Web Tokens (min 32 characters recommended)
JWT_SECRET=your_ultra_secure_random_jwt_secret_token_min_32_chars

# Primary Allowed Frontend Origin for CORS (Production Domain)
FRONTEND_URL=https://be11.in

# Server Port (Managed automatically by Vercel; defaults to 5000 in standalone)
PORT=5000

# Redis Cache URL (Optional: defaults to memory-mock in serverless if omitted or unreachable)
# REDIS_URL=rediss://default:YOUR_PASSWORD@sample-redis.upstash.io:6379

# SMTP / Email Mailer Configuration (Optional: for password resets & verification)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_api_key
# EMAIL_FROM="BE11 Cricket <noreply@be11.in>"

# Google OAuth 2.0 (Optional)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=https://be11.in/api/v1/auth/google/callback

# ==============================================================================
# 2. FRONTEND SAFE ENVIRONMENT VARIABLES (Browser-Accessible via Vite)
# ==============================================================================
# IMPORTANT: Never place database credentials, JWT secrets, or SMTP passwords here!

# Base API URL:
# For same-domain Vercel deployment (https://be11.in/api), leave empty or set to:
# VITE_API_URL=https://be11.in
# For local development:
# VITE_API_URL=http://localhost:5000

# Public Google OAuth Client ID for React Sign-In button (Safe for browser)
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ==============================================================================
# 3. LOCAL DEVELOPMENT VARIABLES
# ==============================================================================
# NODE_ENV=development
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/be11"
# JWT_SECRET=local_development_jwt_secret_key_32_characters_long
# FRONTEND_URL=http://localhost:5173
# PORT=5000
