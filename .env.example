# ==========================================
# BE11 Centralized Environment Variables Config
# ==========================================

# ----------------------------
# Backend Config
# ----------------------------
PORT=5000
NODE_ENV=development

# Database connection URL (for Prisma SQLite default, or external PostgreSQL/MySQL URL)
# For Vercel SQLite hosting, defaults to "file:./backend/prisma/dev.db" in serverless environments.
DATABASE_URL=file:./backend/prisma/dev.db

# Secret key used for signing JWT tokens (should be a long secure string in production)
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production

# Redis server connection URL (falls back to mock client if not provided/reachable)
# REDIS_URL=redis://localhost:6379

# Allowed origin for CORS (optional, defaults to dynamic same-domain mapping on Vercel)
# FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# SMTP / Email Mailer Config (Required for Email Verification & Password Recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@be11.com

# ----------------------------
# Frontend Config
# ----------------------------
# Optional: Base URL of the API.
# Defaults dynamically to http://localhost:5000 in dev mode and same-domain in production.
# VITE_API_URL=http://localhost:5000
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com

